// movies.ontology.gram
//
// Gram translation of movies.yaml, the example in neo4j/ontology-graph-spec
// (schema 1.0.0). Source copy: ./movies.yaml. Originally a spike; brought in line with the
// conventions in design/exploration/EXP-003 and EXP-004.
//
// MAPPING (spec -> gram)
// ======================
//   id, name, version       a Graph pattern: [movies:Graph { name, version } | members]
//   nodes.<id>              (<Label> { ... }). In an ontology the identifier is the
//                           identifying label, so `person` + `label: Person` is just
//                           `(Person ...)`. Implied labels follow as `::Implied`,
//                           optional ones as `:`Optional?``.
//   relationships.<id>      (<From>)=[<TYPE> { ... }]=>(<To>). The identifier of a
//                           relationship is its type; the ends are references to nodes.
//   properties.<key>        record entry `key:: cypher`TYPE``.
//                           must_exist: true  -> `TYPE!`
//                           unique / key      -> @unique(key) / @key(key)
//   description, aliases,   a gramdoc comment on the definition, which reads into a Doc
//   reference               pattern inside the Graph: description is the text, aliases
//                           are @alias tags, a property is documented with @property.
//
// NOT COVERED by this file (not in movies.yaml): longhand named constraints,
// indexes, display, custom, data sources and mappings, relationship counts,
// one_of, pattern, dimension, implied and optional labels, property `name`.
//
// OPEN QUESTIONS
//   - `STRING!` folds the spec's EXISTS constraint into the type string. The spec
//     keeps type and constraint separate.

{
  kind: "ontology"
}


// -----------------------------------------------------------------------------
// NODE DEFINITIONS
// -----------------------------------------------------------------------------

/**
 * A person who acts in movies.
 *
 * @alias Actor
 * @alias Performer
 * @property name The person's full name.
 */
(Person {
  name:: cypher`STRING!`
})

/**
 * A film released to the public.
 *
 * @alias Film
 * @property title The title the movie was released under.
 */
@unique(title)
(Movie {
  title:: cypher`STRING`
})


// -----------------------------------------------------------------------------
// RELATIONSHIP DEFINITIONS
// -----------------------------------------------------------------------------

/**
 * The person appeared in the movie as a cast member.
 *
 * @property role The character the person played.
 */
(Person)=[ACTED_IN {
  role:: cypher`STRING`
}]=>(Movie)


// -----------------------------------------------------------------------------
// THE GRAPH
//
// Lists its members by identity. Documentation from the comments above is read
// into Doc patterns inside this graph.
// -----------------------------------------------------------------------------

/**
 * People and the movies they act in.
 */
[movies:Graph {
  name:    "Movies",
  version: "1.0.0"
} |
  Person, Movie,
  ACTED_IN
]
